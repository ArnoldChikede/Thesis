Plecs {
  Name          "BOOST_CONVETER_MODEL_THESIS"
  Version       "4.8"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "1"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "Vmppt= 10.00  %17.6000 ;%20;\nImppt= 3.6900 ;%15;\nV"
"out = 60;\nI_q=Imppt;\nV_q=Vout;\nfs=80e3 %25e3;\nTs=1/fs;\n\nCin =  100e-06;"
" %3.7500e-06;\nCout= 100e-06 %75e-06;\n\nL = 220e-06     %220   330       %37"
"0e-06     %500e-06;\nL_ESR=1.38e-3; %The should be less than 1%\n %of the loa"
"d resisatance so as not to affect the \n %conversion ratio of the converter "
"\n\nRout= 47 % 55.4324%12;\nD_cycle = 0.7067  % 0.671;\nD_prime = 1-D_cycle;"
"\nNs=300;  % samples for the moving avg filter\n\n\nRon=1e-3;\n\n\n\n%Small s"
"ignal Part \n\n%v_mppt_hat ; \n%d_cycle_hat ;\n%d_prime_hat ;\nd_ss =0.012   "
" %0.012 %-0.004;  %found out dss to be 0.012 for perfect linear approximation"
" \nvin_ss=5;\nstep_time = 0.20;\n\n%Transfer functions \n\n\nVout = 60;\nGdo="
" Vout/D_prime;\nGgo=1/D_prime;\nWz=(Rout*D_prime^2)/L ;\nQ=  D_prime*Rout*sqr"
"t(Cout/L);\nWo= D_prime/sqrt(L*Cout);\n \n \n %Time constants\n T_L = L/L_ESR"
";\n T_C = Rout*Cout\n A=(Vout*D_prime^2)/Rout\n \n \n \n %Controller Paramete"
"rs \n  \nkp = 0.1;%0.0654426 %0.194502 %0.07             %0.3925 %0.45      %"
"0.392;0.4 %\nki = 10; \n\n%MPPT \nMPPT_Ts =1/100 ;\n\n\n\nGid_main = 2*Vout/("
"(1-D_cycle)^2*Rout)"
  InitialState  "1"
