    Component {
      Type          CScript
      Name          "PI_CURRENT_CONTOLLER"
      Show          on
      Position      [725, 455]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[-1920 -199 1920 1009]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "4"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "Ts"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "[kp,  ki, Ts ]"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "//We might However change to Double \n"
"\n"
" double kp ;\n"
" double ki ;  \n"
" double Ts  ; \n"
"\n"
"\n"
"double Iref = 0.0;  //Would like to have type checling \t\t\t\t\t\t//So thats"
" why i dont use Preprocessor Macros eg  #define\n"
"double IL= 0.0;\n"
"double Error = 0.0 ; \n"
"static double Error_Prev = 0.0 ; \n"
"\n"
" double Kp_contribution =  0.0 ;\n"
" double Ki_contribution = 0.0; \n"
"static double Ki_contribution_prev = 0.0; \n"
"\n"
"\n"
"const int Upper_saturation_Limit = 1;\n"
"const int Lower_saturation_Limit = 0;\n"
"\n"
"double PI_Controller_Output;\n"
"double PI_Controller_Output_Saturation_Block ;\n"
"\n"
"\n"
"double duty_control_signal = 0.0 ; \n"
"\n"
"static double Satuaration_block_state_2_input = 0.0;\n"
" \n"
" "
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "kp = ParamRealData(0,0);\n"
"ki = ParamRealData(0,1);\n"
"Ts = 0.001;//ParamRealData(0,2);"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "Iref = Input(0) ; \n"
"IL = Input(1) ;\n"
"Error = Iref - IL ; \n"
"\n"
"//CODE FOR THE PI CONTROLLER\n"
"//SPLIT IN TWO AND THEN ADD EACH CONTRUBUTION \n"
"//FORWARD EULER APPROXIMATION USED FOR DISCRETIZING THE INTERGRATOR\n"
"\n"
"Kp_contribution = kp * Error ;\n"
"\n"
"\n"
"\n"
"Ki_contribution = (Error_Prev)*ki*Ts + Ki_contribution_prev ;  //Always remem"
"ber the Integral works on the Previos value of the error\n"
"//Ki_contribution = (Error-Satuaration_block_state_2_input)*ki*Ts + Ki_contri"
"bution ;\n"
"\n"
"\n"
"PI_Controller_Output = Kp_contribution + Ki_contribution ;\n"
"\n"
" // INCLUDE SATURAION BLOCK \n"
" \n"
" if(PI_Controller_Output <  Lower_saturation_Limit) \n"
" {\n"
"\tPI_Controller_Output_Saturation_Block  = Lower_saturation_Limit;\n"
" }\n"
" \n"
" \n"
" else if(PI_Controller_Output > Upper_saturation_Limit) \n"
" {\n"
"\t PI_Controller_Output_Saturation_Block  = Upper_saturation_Limit;\n"
" }\n"
"  \n"
"else { PI_Controller_Output_Saturation_Block = PI_Controller_Output; }\n"
"\n"
" duty_control_signal =  PI_Controller_Output_Saturation_Block ;\n"
" //duty_control_signal = 0.704; \n"
"   \n"
" Satuaration_block_state_2_input  =  (PI_Controller_Output  - PI_Controller_O"
"utput_Saturation_Block)* 1/kp ;\n"
"\n"
"Error_Prev  = Error;\n"
"Ki_contribution_prev = Ki_contribution;\n"
"\n"
"Output(0) = duty_control_signal   ;\n"
"Output(1) = IL;  //Averaged  IL(sampled)....which is what the controller basi"
"cally sees intead of the rippled current.\n"
"Output(2)=Ki_contribution;\n"
"Output(3)=Ki_contribution_prev;\n"
"\n"
"\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
