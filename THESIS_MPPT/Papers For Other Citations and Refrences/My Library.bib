@article{Illumination_and_Temperature_Effects_on_PV_Cells,
  title = {I-{{V}} and {{P-V}} Characteristics Analysis of a Photovoltaic Module by Different Methods Using {{Matlab}} Software},
  author = {Revati, D. and Natarajan, E.},
  year = 2020,
  month = jan,
  journal = {Materials Today: Proceedings},
  series = {International {{Conference}} on {{Future Generation Functional Materials}} and {{Research}} 2020},
  volume = {33},
  pages = {261--269},
  issn = {2214-7853},
  doi = {10.1016/j.matpr.2020.04.043},
  urldate = {2026-03-21},
  abstract = {In this paper, detailed modelling of photovoltaic modules by three different methods, such as Mathematical Modelling, Simscape Modelling and Matlab coding is presented. For this study, single diode model of photovoltaic module is considered for simulation and the performance analysis of photovoltaic module (I-V and P-V characteristics) was obtained by varying different solar radiation and temperature values. From the simulation results, all the three methods yield almost same output, but the advantage of mathematical modelling over other methods is easy to develop the circuit for simulation and changing the parameter is very easy.},
  keywords = {Mathematical modelling,Performance analysis,Photovoltaic module,Simulation,Simulink/Matlab},
  file = {C\:\\Users\\Arnold\\Zotero\\storage\\4UXDTQPM\\Revati and Natarajan - 2020 - I-V and P-V characteristics analysis of a photovoltaic module by different methods using Matlab soft.pdf;C\:\\Users\\Arnold\\Zotero\\storage\\RG4E5YRB\\S2214785320326584.html}
}
